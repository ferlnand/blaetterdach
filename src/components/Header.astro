---
import { Image } from "astro:assets";
import headerLogo from "../assets/logo_header.webp";
import { url } from "../lib/url";

const links = [
  { href: url("/"), label: "Start" },
  { href: url("leistungen/"), label: "Leistungen" },
  { href: url("unternehmen/"), label: "Für Unternehmen" },
  { href: url("ueber/"), label: "Über mich" },
  { href: url("/#kontakt"), label: "Kontakt" },
];
---

<header>
  <nav>
    <a href={url("/")} class="logo">
      <Image src={headerLogo} alt="blätterdach Baumpflege, zur Startseite" />
    </a>
    <div class="links">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </div>
  </nav>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    z-index: 10;
    width: 100%;
    background-color: #fdfff5;
    border-bottom: 1px solid #ddd;
  }

  nav {
    display: flex;
    align-items: center;
    height: var(--navbar-height);
    padding: 1rem;
    box-sizing: border-box;

    a {
      padding: 8px;
      font-variant-caps: small-caps;
      font-size: 16px;
      font-weight: 600;
      color: #222;
      letter-spacing: 0.04rem;
      text-decoration: none;

      &:hover {
        color: #608540;
        text-decoration: underline;
      }

      &.logo {
        margin-right: auto;
      }

      & > img {
        height: calc(var(--navbar-height) - 1rem);
        width: auto;
        object-fit: contain;
      }
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
  }

  @media (max-width: 760px) {
    nav {
      flex-direction: column;
      height: auto;
      padding: 0.5rem;

      a.logo {
        margin-right: 0;
      }

      a {
        padding: 2px 6px;
        font-size: 14px;
      }

      a > img {
        height: 44px;
      }
    }
  }
</style>
