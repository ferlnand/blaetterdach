---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import headerLogo from "../assets/logo_header.webp";
import { url } from "../lib/url";

const kontakt = (await getEntry("einstellungen", "kontakt"))!.data;
---

<footer>
  <div>
    <div><Image src={headerLogo} alt="blätterdach Baumpflege" /></div>
    <div>
      <div>
        <b>{kontakt.firma}</b>
      </div>
      <div id="info_container">
        <address>
          <span>{kontakt.name}</span>
          <span>{kontakt.strasse}, {kontakt.ort}</span>
          <a href={`tel:${kontakt.telefon.replace(/\s/g, "")}`}>{kontakt.telefon}</a>
          <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
        </address>
        <div>
          <a href={url("impressum/")}>Impressum</a>
          <a href={url("agb/")}>AGB</a>
          <a href={url("datenschutzerklaerung/")}>Datenschutzerklärung</a>
        </div>
      </div>
    </div>
  </div>
  <div>© {new Date().getFullYear()} {kontakt.firma}</div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding: 8rem 4rem 1rem 4rem;
    border-top: 1px solid #d8d8d8;

    & > div {
      flex: 1;
      display: flex;
      justify-content: space-around;
      align-items: center;
      gap: 2rem;

      & > div {
        display: flex;
        flex-direction: column;
      }
    }
  }

  #info_container {
    display: flex;
    gap: 4rem;

    & > address,
    & > div {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      font-style: normal;
      line-height: 2;
    }

    a {
      display: inline;
      color: inherit;
    }
  }

  @media (max-width: 760px) {
    footer {
      gap: 2rem;
      padding: 3rem 1rem 1rem 1rem;

      & > div {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    #info_container {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>
