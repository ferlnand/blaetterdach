---
const { title } = Astro.props;
---

<div>
  <h1>{title}</h1>
</div>

<style>
  div {
    margin-top: var(--navbar-height);
    padding: 0.5rem 2rem;
    color: white;
    background-color: #444;
  }

  h1 {
    font-size: 3rem;
  }

  @media (max-width: 760px) {
    div {
      padding: 0.5rem 1rem;
    }

    h1 {
      font-size: 1.8rem;
    }
  }
</style>
