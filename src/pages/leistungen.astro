---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import PageHeading from "../components/PageHeading.astro";
import Layout from "../layouts/Layout.astro";

const leistungen = (await getCollection("leistungen")).sort((a, b) => a.data.order - b.data.order);
const eintraege = await Promise.all(leistungen.map(async (l) => ({ ...l, Content: (await render(l)).Content })));
---

<Layout
  title="Leistungen"
  description="Baumpflanzung, Jungbaumpflege, Kronenpflege, Totholzentfernung, Rückschnitt, Baumkontrolle, Abtragungen und mehr: alle Leistungen von blätterdach Baumpflege in Wien."
>
  <PageHeading title="Leistungen" />
  {
    eintraege.map(({ id, data, Content }, i) => (
      <section id={id} class:list={{ reverse: i % 2 === 1 }}>
        {data.image && (
          <div>
            <Image src={data.image} alt={data.imageAlt ?? data.title} widths={[400, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" />
          </div>
        )}
        <div>
          <h2>{data.title}</h2>
          <Content />
        </div>
      </section>
    ))
  }
</Layout>

<style>
  section {
    scroll-margin-top: var(--navbar-height);

    & > div {
      max-width: 800px;
    }
  }

  section.reverse {
    flex-direction: row-reverse;
  }

  img {
    border-radius: 8px;
  }

  @media (max-width: 760px) {
    section.reverse {
      flex-direction: column;
    }
  }
</style>
