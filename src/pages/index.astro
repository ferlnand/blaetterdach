---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import headerLogo from "../assets/logo_header.webp";
import { paragraphs, url } from "../lib/url";

const seite = (await getEntry("seiten", "startseite"))!.data;
const b = seite.blocks;
const leistungen = (await getCollection("leistungen")).sort((x, y) => x.data.order - y.data.order);
---

<Layout title={seite.title} description={seite.description}>
  <section class="hero">
    <div>
      <h1>{b.heroTitel}</h1>
      <p class="tagline">{b.heroUntertitel}</p>
      {paragraphs(b.heroText).map((p) => <p>{p}</p>)}
    </div>
    <div><Image src={headerLogo} alt="" /></div>
  </section>
  <section>
    <div>
      <Image src={headerLogo} alt="" />
    </div>
    <div>
      <h2>{b.methodeTitel}</h2>
      {paragraphs(b.methodeText).map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section>
    <div>
      <h2>{b.leistungenTitel}</h2>
      {paragraphs(b.leistungenText).map((p) => <p>{p}</p>)}
    </div>
    <div>
      <Image src={headerLogo} alt="" />
    </div>
  </section>
  <section>
    <nav id="services_buttons" aria-label="Leistungen">
      {
        leistungen.map((l) => (
          <a href={url(`leistungen/#${l.id}`)}>{l.data.button ?? l.data.title}</a>
        ))
      }
    </nav>
  </section>
  <section>
    <div id="kontakt">
      <h2>{b.kontaktTitel}</h2>
      {paragraphs(b.kontaktText).map((p) => <p>{p}</p>)}
      <ContactForm />
    </div>
  </section>
</Layout>

<style>
  .hero {
    min-height: 100vh;
    margin-top: var(--navbar-height);
    color: #eee;
    background-color: #111;
  }
  h1 {
    font-size: 4rem;
    line-height: 1.2;
  }
  .tagline {
    font-size: 2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  #services_buttons {
    width: 80vw;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 3rem;
    max-width: 1300px;

    & > a {
      padding: 12px 24px;
      color: white;
      background-color: #608540;
      border-radius: 24px;
      font-size: large;
      font-weight: 500;
      letter-spacing: 0.04rem;
      text-decoration: none;

      &:hover {
        background-color: #4b6a31;
      }
    }
  }

  #kontakt {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 600px;
    scroll-margin-top: var(--navbar-height);
  }

  @media (max-width: 760px) {
    .hero {
      min-height: auto;
    }
    h1 {
      font-size: 2.2rem;
    }
    .tagline {
      font-size: 1.3rem;
    }
    #services_buttons {
      width: 100%;
      gap: 0.75rem;
    }
  }
</style>
