---
import { getEntry } from "astro:content";
import { Image } from "astro:assets";
import PageHeading from "../components/PageHeading.astro";
import Layout from "../layouts/Layout.astro";
import headerLogo from "../assets/logo_header.webp";
import { paragraphs } from "../lib/url";

const seite = (await getEntry("seiten", "ueber"))!.data;
const b = seite.blocks;
---

<Layout title={seite.title} description={seite.description}>
  <PageHeading title={seite.title} />
  <section>
    <div>
      <Image src={headerLogo} alt="" />
    </div>
    <div>
      <h2>{b.werTitel}</h2>
      {paragraphs(b.werText).map((p) => <p>{p}</p>)}
    </div>
  </section>
  <section class="philosophie">
    <div>
      <h2>{b.philosophieTitel}</h2>
      {paragraphs(b.philosophieText).map((p) => <p>{p}</p>)}
    </div>
  </section>
</Layout>

<style>
  section > div {
    max-width: 700px;
  }

  .philosophie > div {
    max-width: 1000px;
  }
</style>
