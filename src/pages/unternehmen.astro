---
import { getEntry } from "astro:content";
import PageHeading from "../components/PageHeading.astro";
import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
import { paragraphs } from "../lib/url";

const seite = (await getEntry("seiten", "unternehmen"))!.data;
const b = seite.blocks;
---

<Layout title={seite.title} description={seite.description}>
  <PageHeading title={seite.title} />
  <section>
    <div>
      <h2>{b.titel}</h2>
      {paragraphs(b.text).map((p) => <p>{p}</p>)}
    </div>
    <div>
      <ContactForm variant="unternehmen" />
    </div>
  </section>
</Layout>

<style>
  section > div {
    max-width: 600px;
  }
</style>
